{
  "name": "novel-reader",
  "displayName": "小说阅读器",
  "description": "导入本地 txt 小说，自动解析章节目录，提供沉浸式阅读界面。支持我的书架、字体大小/字体族/行距/主题配色等个性化设置，并自动延续上次阅读状态。",
  "version": "1.1.0",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/rich-woman-hugs-me-to-sleep/r-novel-reader.git"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "小说",
    "阅读",
    "novel",
    "reader",
    "txt",
    "电子书"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:novelReaderChapters",
    "onCommand:novelReader.openFile",
    "onCommand:novelReader.openBook",
    "onCommand:novelReader.removeFromShelf",
    "onCommand:novelReader.resumeCurrent",
    "onCommand:novelReader.showBookshelf",
    "onCommand:novelReader.showChapters",
    "onCommand:novelReader.openChapter",
    "onCommand:novelReader.refresh",
    "onCommand:novelReader.openSettings",
    "onCommand:novelReader.prevChapter",
    "onCommand:novelReader.nextChapter"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "xiaoshuo-reader",
          "title": "小说阅读",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "xiaoshuo-reader": [
        {
          "id": "novelReaderChapters",
          "name": "书架 / 目录",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "novelReader.showBookshelf",
        "title": "我的书架",
        "icon": "$(library)"
      },
      {
        "command": "novelReader.showChapters",
        "title": "章节目录",
        "icon": "$(book)"
      },
      {
        "command": "novelReader.openFile",
        "title": "打开小说文件",
        "icon": "$(add)"
      },
      {
        "command": "novelReader.refresh",
        "title": "刷新目录",
        "icon": "$(refresh)",
        "enablement": "novelReader.hasNovel"
      },
      {
        "command": "novelReader.openSettings",
        "title": "阅读设置",
        "icon": "$(settings-gear)",
        "enablement": "novelReader.hasNovel"
      },
      {
        "command": "novelReader.resumeCurrent",
        "title": "回到当前阅读章节"
      },
      {
        "command": "novelReader.openBook",
        "title": "打开书架中的小说"
      },
      {
        "command": "novelReader.removeFromShelf",
        "title": "从书架移除"
      },
      {
        "command": "novelReader.openChapter",
        "title": "阅读本章"
      },
      {
        "command": "novelReader.prevChapter",
        "title": "上一章",
        "enablement": "novelReader.hasNovel"
      },
      {
        "command": "novelReader.nextChapter",
        "title": "下一章",
        "enablement": "novelReader.hasNovel"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "novelReader.showBookshelf",
          "when": "view == novelReaderChapters && novelReader.viewMode != shelf",
          "group": "navigation@1"
        },
        {
          "command": "novelReader.showChapters",
          "when": "view == novelReaderChapters && novelReader.viewMode == shelf",
          "group": "navigation@1"
        },
        {
          "command": "novelReader.openFile",
          "when": "view == novelReaderChapters",
          "group": "navigation@2"
        },
        {
          "command": "novelReader.refresh",
          "when": "view == novelReaderChapters && novelReader.viewMode != shelf && novelReader.hasNovel",
          "group": "navigation@3"
        },
        {
          "command": "novelReader.openSettings",
          "when": "view == novelReaderChapters && novelReader.hasNovel",
          "group": "navigation@4"
        }
      ],
      "commandPalette": [
        {
          "command": "novelReader.openFile",
          "title": "小说阅读器: 打开小说文件"
        },
        {
          "command": "novelReader.showBookshelf",
          "title": "小说阅读器: 我的书架"
        },
        {
          "command": "novelReader.showChapters",
          "title": "小说阅读器: 显示章节目录"
        },
        {
          "command": "novelReader.resumeCurrent",
          "title": "小说阅读器: 回到当前阅读章节"
        },
        {
          "command": "novelReader.openSettings",
          "title": "小说阅读器: 阅读设置",
          "when": "novelReader.hasNovel"
        },
        {
          "command": "novelReader.openBook",
          "when": "false"
        },
        {
          "command": "novelReader.removeFromShelf",
          "when": "false"
        },
        {
          "command": "novelReader.openChapter",
          "when": "false"
        },
        {
          "command": "novelReader.refresh",
          "when": "novelReader.hasNovel"
        },
        {
          "command": "novelReader.prevChapter",
          "when": "novelReader.hasNovel"
        },
        {
          "command": "novelReader.nextChapter",
          "when": "novelReader.hasNovel"
        }
      ],
      "explorer/context": [
        {
          "command": "novelReader.openFile",
          "when": "resourceExtname == .txt",
          "group": "navigation@10"
        }
      ]
    },
    "configuration": {
      "title": "小说阅读器",
      "properties": {
        "novelReader.fontSize": {
          "type": "number",
          "default": 16,
          "minimum": 12,
          "maximum": 32,
          "description": "正文字号（像素）"
        },
        "novelReader.fontFamily": {
          "type": "string",
          "default": "system",
          "enum": [
            "system",
            "songti",
            "heiti",
            "kaiti",
            "fangsong",
            "yahei"
          ],
          "enumDescriptions": [
            "系统默认",
            "宋体",
            "黑体",
            "楷体",
            "仿宋",
            "微软雅黑"
          ],
          "description": "正文字体族"
        },
        "novelReader.lineHeight": {
          "type": "number",
          "default": 1.8,
          "minimum": 1.2,
          "maximum": 2.8,
          "description": "正文行距"
        },
        "novelReader.paragraphSpacing": {
          "type": "number",
          "default": 0.8,
          "minimum": 0,
          "maximum": 2,
          "description": "段落间距（em）"
        },
        "novelReader.theme": {
          "type": "string",
          "default": "sepia",
          "enum": [
            "sepia",
            "green",
            "white",
            "gray",
            "dark",
            "ink"
          ],
          "enumDescriptions": [
            "米黄纸",
            "护眼绿",
            "纯净白",
            "简约灰",
            "暗夜",
            "墨黑"
          ],
          "description": "阅读区主题配色"
        },
        "novelReader.contentWidth": {
          "type": "number",
          "default": 720,
          "minimum": 480,
          "maximum": 1200,
          "description": "阅读区域最大宽度（像素）"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --baseContentUrl https://gitee.com/rich-woman-hugs-me-to-sleep/r-novel-reader/blob/master --baseImagesUrl https://gitee.com/rich-woman-hugs-me-to-sleep/r-novel-reader/raw/master",
    "test": "node scripts/test-shelf.js && node scripts/test-parser.js && node scripts/smoke-webview.js"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.3.3"
  }
}
