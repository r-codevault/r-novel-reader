{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "运行小说阅读插件",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "preLaunchTask": "build:ext+webview"
    }
  ]
}
